  audioSource: {fileID: 1222275895617662352}
  mensajeText: {fileID: 1345461580}
  videos:
  - {fileID: 32900000, guid: f1c28e339525de84a92b407366e28416, type: 3}
  - {fileID: 32900000, guid: 3f2564a814a86d64aa536c63bccd9ba2, type: 3}
  mensajes:
  - "En este lugar, el aroma es fuerte, donde el l\xEDquido oscuro es reconfortante.
    La gente aqu\xED viene a charlar o estudiar, y muchos se sientan con tazas a
    esperar. \xBFQu\xE9 lugar es?"
  - "Un lugar de escucha y sanaci\xF3n, donde las palabras alivian la presi\xF3n.
    Aqu\xED las emociones encuentran salida, y se busca la paz para mejorar la vida.
    \xBFQu\xE9 lugar es?"
  scriptAControlar: {fileID: 665242793}
  llave: {fileID: 92015827}
